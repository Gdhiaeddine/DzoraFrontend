# Public API URL for browser/client-side communication with NestJS backend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-side API URL for Next.js SSR / Server Actions / Middleware
BACKEND_URL=http://localhost:3001

# Optional Admin Gateway protection token
# ADMIN_GATEWAY_TOKEN=
# NEXT_PUBLIC_ADMIN_GATEWAY_KEY=
